# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# Original PNGs, archived by tools/convert-images.py after re-encoding to WebP.
# Kept on disk (and in OneDrive) so they can be re-encoded at other settings, but out of
# git and out of the Netlify deploy — anything left under public/ ships with every build.
/_original-images

# System reference publications (NATOPS extracts, checklist pages, briefing decks),
# one folder per system. Kept on disk so a diagram can be checked against its source,
# but out of git and out of the Netlify deploy.
/_reference-docs

# DynamoDB tables exported before they were deleted. TW4Users holds password hashes.
/_aws-archive

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local
leftovers.js

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Claude Code local settings (machine-specific)
.claude/settings.local.json
CLAUDE.md

# Python bytecode from tools/convert-images.py and tools/extract-jppt-flow.py. Regenerated on
# every run and tied to the interpreter version, so it is never worth committing.
__pycache__/
*.py[cod]

# AWS lambda: vendored dependencies. submitDoc has a package.json, so the folder is
# rebuilt with `npm install` in it; what gets zipped up to the console is the local copy.
lambda/submitDoc/node_modules/

# discussApi: the lint rules are copied in from tools/lib at deploy time; a build artefact
lambda/discussApi/discussRules.mjs
lambda/**/function.zip

# Local state for tools/discuss-dev-server.js
/_discuss-dev

# Discuss audit: local only, never committed
tools/discuss-audit.js
tools/discuss-audit.md
tools/discuss-audit.json

# Local state for tools/docs-dev-server.mjs
/_docs-dev
